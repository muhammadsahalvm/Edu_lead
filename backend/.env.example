# Django Core Settings
SECRET_KEY=django-insecure-edulead-admission-management-dev-key-2026-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=edulead_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Fallback SQLite toggle for testing or when MySQL is unconfigured:
# USE_SQLITE_FALLBACK=False

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Business Rule Thresholds (Ageing in days)
LEAD_FRESH_DAYS_MAX=2
LEAD_AGEING_DAYS_MAX=7
