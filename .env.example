# ========================================================
# EduLead — Admission Lead Management System Environment Config
# ========================================================
# Copy this file to `backend/.env` for backend configuration
# Copy or set `VITE_API_BASE_URL` in `frontend/.env` for production frontend

# --------------------------------------------------------
# 1. Django Backend Configuration (backend/.env)
# --------------------------------------------------------

# Core Security
DEBUG=True
SECRET_KEY=django-insecure-edulead-admission-management-dev-key-2026-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL / TiDB Cloud Serverless)
# Option A: Individual DB variables
DB_ENGINE=django.db.backends.mysql
DB_NAME=edulead_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=False

# Option B: Standard full connection string (e.g. for Render / Cloud providers)
# DATABASE_URL=mysql://user:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/test?ssl-mode=REQUIRED

# SQLite fallback toggle (set to True for lightweight dev/testing without MySQL)
USE_SQLITE_FALLBACK=False

# Cross-Origin Resource Sharing (CORS) & CSRF Trusted Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Token Lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Institutional Lead SLA & Ageing Thresholds (in days)
LEAD_FRESH_DAYS_MAX=2
LEAD_AGEING_DAYS_MAX=7

# --------------------------------------------------------
# 2. React / Vite Frontend Configuration (frontend/.env)
# --------------------------------------------------------
# Leave blank for local development (uses Vite dev proxy to 127.0.0.1:8000)
# Set to your deployed backend URL in production (e.g., https://edulead-api.onrender.com)
VITE_API_BASE_URL=

